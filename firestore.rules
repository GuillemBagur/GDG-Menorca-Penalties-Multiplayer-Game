rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function getMatch(code) {
      return get(/databases/$(database)/documents/matches/$(code)).data;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /matches/{code} {
      allow read: if isSignedIn();

      allow create: if isGoogleUser()
        && request.resource.data.hostUid == request.auth.uid
        && (!('guestUid' in request.resource.data) || request.resource.data.guestUid == null)
        && request.resource.data.status == 'waiting';

      allow update: if isSignedIn() && (
        // Guest joining
        (
          resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.status == 'playing'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid', 'guestName', 'guestIsAnonymous', 'status'])
        ) ||
        // Host finishing
        (
          resource.data.hostUid == request.auth.uid
          && request.resource.data.status == 'finished'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );

      allow delete: if false;

      match /events/{seq} {
        allow read: if isSignedIn() && (
          getMatch(code).hostUid == request.auth.uid ||
          getMatch(code).guestUid == request.auth.uid
        );

        allow create: if isSignedIn() && (
          getMatch(code).hostUid == request.auth.uid ||
          getMatch(code).guestUid == request.auth.uid
        ) && request.resource.data.playerId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
